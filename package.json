{
  "author": "Jason Williscroft",
  "bin": {
    "mycli": "./dist/cli/mycli/index.js"
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/npm-package-template-ts/issues"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "description": "A feature-rich NPM package template for TypeScript projects.",
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@dotenvx/dotenvx": "^2.24.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "git-cliff": "^2.13.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "fs-extra": "^11.4.0",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/karmaniverous/npm-package-template-ts#readme",
  "keywords": [
    "eslint",
    "lefthook",
    "npm",
    "prettier",
    "rollup",
    "template",
    "typescript",
    "vitest"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "name": "@karmaniverous/npm-package-template-ts",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run knip",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ],
      "after:bump": [
        "npx git-cliff -o CHANGELOG.md",
        "npm run docs",
        "git add CHANGELOG.md"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/npm-package-template-ts.git"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "changelog": "git-cliff -o CHANGELOG.md",
    "diagrams": "cd diagrams/src && plantuml -tpng -o ../out -r .",
    "docs": "typedoc",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.7.0"
}
